{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mkw-tracker",
  "version": "0.2.11",
  "identifier": "com.paulporkhogkart.mkw-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:full",
    "frontendDist": "../dist-ui"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "sidecar/mkw-tracker-engine.exe": "bin/mkw-tracker-engine.exe",
      "sidecar/_internal": "bin/_internal"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/paulporkhogkart/mkw-split-rewrite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NDhGMUZEQTI1MkE3RDcKUldUWHAxS2kvZkZJV0VsRmhmK052NFJVSjEwZkp1NUg5VnZsNnhEQzdlRUtNeWYrS0tpNDhLVlAK"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MKW Split",
        "width": 1200,
        "height": 800,
        "center": true,
        "resizable": true,
        "minWidth": 600,
        "minHeight": 440,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
