{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pbenguin",
  "version": "3.2.0",
  "identifier": "com.paulporkhogkart.mkw-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:full",
    "frontendDist": "../dist-ui"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "resources": {
      "sidecar/mkw-tracker-engine.exe": "bin/mkw-tracker-engine.exe",
      "sidecar/_internal": "bin/_internal"
    }
  },
  "plugins": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  }
}
