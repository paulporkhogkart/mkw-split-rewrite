{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mkw-tracker",
  "version": "0.1.5",
  "identifier": "com.paulporkhogkart.mkw-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:full",
    "frontendDist": "../dist-ui"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/mkw-tracker"],
    "resources": {
      "binaries/_internal": "_internal"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/paulporkhogkart/mkw-split-rewrite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NDhGMUZEQTI1MkE3RDcKUldUWHAxS2kvZkZJV0VsRmhmK052NFJVSjEwZkp1NUg5VnZsNnhEQzdlRUtNeWYrS0tpNDhLVlAK"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MKW Tracker",
        "width": 400,
        "height": 300,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
